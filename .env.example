# 브라우저 공개 설정 — RLS가 적용되어 있어야 합니다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# 서버 전용 설정 — 절대 NEXT_PUBLIC_ 접두사를 붙이거나 커밋하지 않습니다.
SUPABASE_SECRET_KEY=

# Web Push VAPID 키. `npx web-push generate-vapid-keys`로 한 번 생성해 배포 환경에도 동일하게 등록합니다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:privacy@example.com

# Vercel Cron이 목표 마감 알림 Route Handler를 호출할 때 사용하는 서버 전용 비밀값
CRON_SECRET=

# Chrome Web Store 확장 프로그램 ID. 여러 ID는 쉼표로 구분합니다.
SOLVESYNC_EXTENSION_IDS=
# 웹 앱이 현재 브라우저의 확장 프로그램 상태를 확인할 때 사용하는 공개 ID입니다.
NEXT_PUBLIC_SOLVESYNC_EXTENSION_ID=dgghaooaokpafdhjgieajelgbilacmkd

# 개인정보 처리방침에 표시할 운영자 문의 이메일 (서버 전용)
PRIVACY_CONTACT_EMAIL=
